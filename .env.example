# Copia este archivo a .env y completa los valores.
# .env no se versiona; este ejemplo sí.

# API key de la cuenta de Telnyx (nunca la subas al repositorio)
TELNYX_API_KEY=

# Números en formato E.164
TELNYX_FROM=+56XXXXXXXXX
TELNYX_TO=+56YYYYYYYYY

# App de Call Control que origina la llamada
TELNYX_CONNECTION_ID=

# Secreto de la ruta del webhook: /hook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# Puerto local del webhook
PORT=8000

# Se llena solo al ejecutar: python3 agente/assistant.py "PET-CT"
ASSISTANT_ID=
